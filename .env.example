# ── 必填 ──
MINIMAX_API_KEY=
# Key 所属区域：cn = api.minimaxi.com（大陆账号），global = api.minimax.io（国际账号）
# 区域必须和 Key 配对，打错区域会返回 2049 invalid api key
MINIMAX_REGION=cn

# ── 可选 ──
MINIMAX_TOKEN_PLAN_API_KEY=

# 邀请码配置 — 格式：用户代号:密码,用户代号:密码
# 仅用于聊天/创建角色的访客邀请码，绝不能当作运维控制面密码使用
USER_CODES=

# ops_control.py（独立运维控制面，start/stop/restart 生产服务）专用密码
# 格式同上，但必须和 USER_CODES 用不同的码 —— 只部署在跑 ops_control.py
# 的主机（EC2，systemd EnvironmentFile），Railway 部署不需要这一项
OPS_CONTROL_CODES=

# 高级用户使用的服务 Key，留空则回退到 MINIMAX_API_KEY
PREMIUM_API_KEY=
# 高级 Key 所属区域，留空则跟随 MINIMAX_REGION
PREMIUM_MINIMAX_REGION=

# 体验帐户默认对话额度
TRIAL_QUOTA=20

# 登录会话有效期（天）
SESSION_TTL_DAYS=7

# 管理员初始账号 — 仅在库中还没有任何管理员时生效
# 不配置 ADMIN_PASSWORD 则随机生成，并在启动日志里打印一次
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PYTHONUNBUFFERED=1
